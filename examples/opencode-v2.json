{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "notion": {
      "name": "Notion Agent",
      "env": ["NOTION_CONNECTOR_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {"baseURL": "http://127.0.0.1:8765/v1"},
      "models": {"notion-auto": {"name": "Notion · автоматический выбор"}}
    }
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "oauth": false,
      "timeout": 300000,
      "enabled": true,
      "headers": {"Authorization": "Bearer {env:NOTION_CONNECTOR_KEY}"}
    }
  }
}
